{
  "schemaVersion": 1,
  "id": "com.voiceos.generated.asana-composio",
  "version": "1.0.0",
  "name": "Asana Tasks",
  "summary": "Create tasks in Asana My Tasks via Composio, with due date/time, project and section.",
  "description": "Add tasks to your Asana 'My Tasks' using Composio OAuth2. Pick a due date and time, a project, and a My Tasks section on the confirmation card. Your primary workspace is detected automatically.",
  "supportedPlatforms": [
    "darwin",
    "win32"
  ],
  "publisher": {
    "id": "pub_user",
    "name": "Made in VoiceOS"
  },
  "runtime": {
    "kind": "local-mcp",
    "command": "/bin/zsh",
    "args": [
      "run.sh"
    ]
  },
  "permissions": [
    {
      "kind": "network",
      "domains": [
        "backend.composio.dev"
      ]
    }
  ],
  "preferences": [
    {
      "name": "COMPOSIO_API_KEY",
      "title": "Composio API key",
      "description": "Settings -> API Keys in your Composio dashboard (platform.composio.dev/settings).",
      "type": "password",
      "required": true
    },
    {
      "name": "COMPOSIO_ENTITY_ID",
      "title": "Composio user ID",
      "description": "The Composio user_id your Asana account is connected under (Connected Accounts in the Composio dashboard). Leave blank for 'default'.",
      "type": "text",
      "required": false,
      "default": "default"
    },
    {
      "name": "ASANA_WORKSPACE_GID",
      "title": "Asana workspace GID",
      "description": "Optional workspace GID override. Leave blank to auto-detect your primary workspace.",
      "type": "text",
      "required": false,
      "default": ""
    }
  ],
  "tools": [
    {
      "name": "list_asana_options",
      "title": "List Asana projects and sections",
      "description": "List the user's Asana projects and their My Tasks sections (e.g. Recently assigned / Today / Next week / Later — users can rename or add their own). Always call this right before create_task and pass the results as project_choices and section_choices. Also use when the user asks which Asana projects or My Tasks sections they have.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "visibility": "agent"
    },
    {
      "name": "create_task",
      "title": "Create task",
      "description": "Create a new task assigned to the user in Asana My Tasks via Composio. Use when the user asks to create, add, or schedule a task or todo in Asana. First call list_asana_options and pass its projects and sections as project_choices and section_choices so the user can pick them on the confirmation card. Set project / section only when the user named one, using its gid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Task name or title"
          },
          "due_on": {
            "type": "string",
            "description": "Optional due date, YYYY-MM-DD"
          },
          "due_time": {
            "type": "string",
            "description": "Optional due time in the user's local time, 24h HH:MM; requires due_on"
          },
          "project": {
            "type": "string",
            "description": "Optional project gid from list_asana_options"
          },
          "section": {
            "type": "string",
            "description": "Optional My Tasks section gid from list_asana_options"
          },
          "project_choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gid": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "gid",
                "name"
              ]
            },
            "description": "The projects array returned by list_asana_options, passed through unchanged"
          },
          "section_choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gid": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "gid",
                "name"
              ]
            },
            "description": "The sections array returned by list_asana_options, passed through unchanged"
          }
        },
        "required": [
          "name"
        ]
      },
      "confirmation": {
        "schemaVersion": 1,
        "root": {
          "type": "widget",
          "html": "<!doctype html><html data-k-accent=\"\" style=\"--accent:#f06a6a;--accent-light:#d35d5d\"><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box;margin:0;padding:0;scrollbar-width:none}\n/* No scrollbar chrome, EVER — on the document or on anything an author makes\n   scrollable inside it. A card is glanced at on black glass; a scrollbar is\n   desktop-browser furniture that instantly breaks that. This is the same\n   rule the notch window applies to itself, mirrored here because the host's\n   CSS cannot reach into the sandbox. Content stays scrollable (wheel,\n   trackpad, drag) — only the bar is gone. */\n::-webkit-scrollbar{display:none}\n:root{--ink-1:rgba(255,255,255,.95);--ink-2:rgba(255,255,255,.72);--ink-3:rgba(255,255,255,.5);--ink-4:rgba(255,255,255,.42);--line:rgba(255,255,255,.08);--fill-1:rgba(255,255,255,.06);--fill-2:rgba(255,255,255,.1);--track:rgba(255,255,255,.12);--good:#30d158;--bad:#ff453a;--accent:#3987e5;--k-radius:26px;color-scheme:dark}\nhtml[data-k-theme=light]{--ink-1:rgba(0,0,0,.92);--ink-2:rgba(0,0,0,.66);--ink-3:rgba(0,0,0,.46);--ink-4:rgba(0,0,0,.38);--line:rgba(0,0,0,.09);--fill-1:rgba(0,0,0,.04);--fill-2:rgba(0,0,0,.07);--track:rgba(0,0,0,.1);color-scheme:light;--accent:var(--accent-light,#2563c9)}\n/* A body background PROPAGATES to the frame canvas — a transparent root does\n   not stop that; per spec the canvas takes body's background when the root\n   has none. So an author's `body{background:#111}` fills the whole frame,\n   square and full-height, which is the right outcome: every host clips the\n   frame at the card arc, so the fill meets the corner exactly. The one trap\n   is repeat — the canvas tiles a gradient sized to a short body, so any\n   gradient put on body must say no-repeat (the kit's accent wash does). */\nbody{font:13.5px/1.45 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",system-ui,sans-serif;color:var(--ink-1);background:transparent;border-radius:var(--k-radius);-webkit-font-smoothing:antialiased}\n.k-wrap{padding:13px 15px 14px;display:flex;flex-direction:column;gap:10px;border-radius:var(--k-radius)}\n.k-wrap.k-confirm{padding-bottom:52px}\n.k-num{font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\"}\n.k-hd{display:flex;align-items:center;justify-content:space-between;gap:10px}\n.k-hd-l{display:flex;align-items:center;gap:7px;min-width:0}\n.k-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex:none}\n.k-mk{display:flex;align-items:center;flex:none}\n.k-mk:empty{display:none}\n.k-mk-i{width:15px;height:15px;border-radius:4px;object-fit:contain;display:block}\n.k-hd-t{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-hd-tr{font-size:11px;color:var(--ink-4);white-space:nowrap;flex:none}\n.k-hd-sub{font-size:14.5px;font-weight:590;letter-spacing:-.01em;margin-top:-4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-list{display:flex;flex-direction:column}\n.k-rw{display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--line);text-decoration:none;color:inherit;min-width:0}\n.k-rw:first-child{border-top:0;padding-top:1px}\na.k-rw{cursor:pointer}\na.k-rw:hover .k-rw-t{color:var(--accent)}\n.k-rw-img{width:32px;height:32px;border-radius:6px;object-fit:cover;flex:none;background:var(--fill-1)}\n.k-rw-m{min-width:0;flex:1}\n.k-rw-t{font-size:14px;font-weight:590;letter-spacing:-.01em;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-rw-sub{font-size:11.5px;color:var(--ink-3);line-height:1.35;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-rw-tr{text-align:right;flex:none;display:flex;flex-direction:column;align-items:flex-end}\n.k-rw-tr .k-num{font-size:12px;color:var(--ink-2)}\n.k-rw-trs{font-size:10px;color:var(--ink-4);line-height:1.2}\n.k-more{font-size:11px;color:var(--ink-4);padding-top:7px;border-top:1px solid var(--line)}\n.k-chip{font-size:10.5px;font-weight:600;letter-spacing:.02em;padding:2px 7px;border-radius:999px;background:var(--fill-1);white-space:nowrap;flex:none}\n.k-bdg{display:flex;gap:6px;flex-wrap:wrap}\n.k-sts{display:flex;gap:18px}\n.k-sts.k-ruled{padding-top:9px;border-top:1px solid var(--line)}\n.k-st{min-width:0}\n.k-st-v{font-size:24px;font-weight:600;letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.k-st-d{font-size:11px;font-weight:500;color:var(--ink-3);margin-left:5px;letter-spacing:0}\n.k-st-l{font-size:11px;color:var(--ink-3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-kvs{display:flex;flex-direction:column;gap:0}\n.k-kv{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:3px 0}\n.k-kv-l{font-size:12.5px;color:var(--ink-3);white-space:nowrap}\n.k-kv-v{font-size:12.5px;color:var(--ink-1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}\n.k-bars{display:flex;align-items:flex-end;gap:6px;height:72px}\n.k-bar{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0}\n.k-bar-c{width:100%;height:56px;display:flex;align-items:flex-end;justify-content:center;position:relative}\n.k-bar-f{width:100%;background:var(--fill-2);border-radius:4px 4px 2px 2px}\n.k-bar-f.k-on{background:var(--accent)}\n.k-bar-v{position:absolute;top:-2px;font-size:10px;font-weight:600;color:var(--ink-2);font-variant-numeric:tabular-nums}\n.k-bar-l{font-size:10px;color:var(--ink-4);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}\n.k-spk{width:100%;height:32px;display:block;overflow:visible}\n.k-spk-x{display:flex;justify-content:space-between;font-size:10px;color:var(--ink-4);margin-top:4px;font-variant-numeric:tabular-nums}\n.k-cap{font-size:10px;color:var(--ink-4);margin-top:4px}\n.k-mt-h{display:flex;justify-content:space-between;gap:12px;font-size:11.5px;color:var(--ink-3);margin-bottom:6px}\n.k-mt{height:5px;border-radius:5px;background:var(--track);overflow:hidden}\n.k-mt-f{height:100%;border-radius:5px}\n.k-hero{display:flex;align-items:center;gap:12px;min-width:0}\n.k-hero-img{width:52px;height:52px;border-radius:8px;object-fit:cover;flex:none;background:var(--fill-1)}\n.k-hero-m{min-width:0}\n.k-hero-e{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-4)}\n.k-hero-t{font-size:17px;font-weight:640;letter-spacing:-.02em;line-height:1.2;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-hero-s{font-size:12.5px;color:var(--ink-3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.k-note{font-size:12.5px;line-height:1.4;color:var(--ink-2);overflow-wrap:anywhere;word-break:break-word}\n.k-div{height:1px;background:var(--line);margin:4px 0}\n.k-empty{text-align:center;padding:8px 0}\n.k-empty-t{font-size:13px;color:var(--ink-3)}\n.k-empty-h{font-size:11.5px;color:var(--ink-4);margin-top:3px}\n.k-fld{display:block}\n.k-fld-l{display:block;font-size:11px;color:var(--ink-3);margin-bottom:5px}\n.k-in{width:100%;font:13px/1.4 inherit;color:var(--ink-1);background:var(--fill-1);border:1px solid var(--line);border-radius:7px;padding:7px 9px;outline:none;resize:none}\n.k-in:focus{border-color:var(--accent)}\n/* Custom-card shell (renderCustom): no padding, no gap, no layout opinion —\n   the author owns the surface edge to edge. Only the confirm reserve, the\n   floated mark, and the corner are the kit's.\n\n   The corner is the kit's because it is not the author's to choose: the host\n   cuts the card at --k-radius whatever this document says, so a surface drawn\n   at any other radius shows a second edge inside the real one. Carrying it\n   here means a card that paints a background or border on this element lands\n   on the host's arc for free; a card that paints its own root still has\n   var(--k-radius) to name. */\n.k-cwrap{position:relative;border-radius:var(--k-radius)}\n.k-cwrap.k-confirm{padding-bottom:52px}\n.k-mkbar{position:absolute;top:11px;left:13px;z-index:9;display:flex}\n/* ---- Surface finish (default-on) ----------------------------------------\n   The liquid-glass rim: a 1px hairline with a brighter top edge, drawn as an\n   INSET shadow on a fixed overlay so it (a) hugs the visible frame whatever\n   height the content settles at, and (b) shares border-radius:var(--k-radius)\n   with the host's clip — same arc, drawn inward, so it can neither gap nor\n   get shaved by the cutout. This is the same rim recipe the notch's own\n   chrome uses. */\n.k-rim{position:fixed;inset:0;pointer-events:none;z-index:40;border-radius:var(--k-radius);box-shadow:inset 0 1px 0 rgba(255,255,255,.13),inset 0 0 0 1px rgba(255,255,255,.07)}\nhtml[data-k-theme=light] .k-rim{box-shadow:inset 0 1px 0 rgba(255,255,255,.7),inset 0 0 0 1px rgba(0,0,0,.1)}\n/* Brand presence (only when the integration declared an accent):\n   a soft wash of the brand colour bleeding out of the top-left corner —\n   colour the SURFACE, never the mark. The mark stays the bare glyph: a tile\n   painted under the logo is chrome the icon didn't ask for, and it reads as\n   the harness inventing a colour (see WIDGET_MARK_FLATTEN_HTML in ../ui.ts,\n   which strips exactly that tile out of documents generated while the kit\n   still drew one). color-mix degrades to no wash on engines without it. */\nhtml[data-k-accent] body{background:radial-gradient(150% 120% at 0% 0%,color-mix(in srgb,var(--accent) 15%,transparent),transparent 44%) no-repeat}\nhtml[data-k-theme=light][data-k-accent] body{background:radial-gradient(150% 120% at 0% 0%,color-mix(in srgb,var(--accent) 9%,transparent),transparent 44%) no-repeat}\n/* The entrance is OPT-IN, never opt-out. Declaring `animation: … both` from\n   opacity:0 and cancelling it under prefers-reduced-motion:reduce means any\n   environment that doesn't actually run animations — a headless renderer, a\n   paused compositor, a screenshotter — paints an invisible card and never\n   recovers. Gating on no-preference makes the un-animated state the readable\n   one, so the worst case is a card that simply appears. */\n@media(prefers-reduced-motion:no-preference){\n.k-wrap>*{animation:k-in .34s cubic-bezier(.22,.61,.36,1) both}\n.k-wrap>*:nth-child(2){animation-delay:.04s}\n.k-wrap>*:nth-child(3){animation-delay:.08s}\n.k-wrap>*:nth-child(n+4){animation-delay:.12s}\n}\n@keyframes k-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}\n\n.as{position:relative;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",Roboto,sans-serif;padding:10px 14px 2px;color:var(--ink-1);--pop:#2b2b2f}\nhtml[data-k-theme=light] .as{--pop:#fff}\n/* Same header as the result card (server.ts) so the two read as one flow. */\n.as-head{display:flex;align-items:center;gap:8px;margin-bottom:9px}\n.as-chip{font-size:10px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:var(--ink-4)}\n.as-title{display:block;width:100%;padding:2px 0 7px;margin-bottom:8px;background:transparent;border:0;border-bottom:2px solid var(--accent);outline:none;font:inherit;font-size:17px;font-weight:600;letter-spacing:-.01em;line-height:1.3;color:var(--ink-1)}\n.as-title::placeholder{color:var(--ink-4)}\n\n.as-row{display:flex;align-items:center;min-height:32px}\n.as-lbl{flex:none;width:58px;font-size:12px;color:var(--ink-3)}\n.as-val{flex:1;min-width:0;display:flex;align-items:center;gap:6px;height:28px;margin-left:-8px;padding:0 8px;border:0;border-radius:7px;background:transparent;color:var(--ink-1);font:inherit;font-size:13px;font-weight:500;text-align:left;cursor:pointer}\n.as-val>span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.as-val:hover,.as-val[aria-expanded=true]{background:var(--fill-1)}\n.as-val.as-empty{color:var(--ink-3)}\n.as-val svg{flex:none;color:var(--ink-4);transition:transform .15s ease}\n.as-val[aria-expanded=true] svg{transform:rotate(180deg)}\n.as-time{font-variant-numeric:tabular-nums}\n\n.as-val .as-ic{flex:none;color:var(--ink-3)}\n/* Date and time share the Due row; the time button only appears once there is a date. */\n.as-val+.as-val{margin-left:4px}\n#as-due-btn{flex:7}\n.as-time{flex:3}\n.as-val[hidden]{display:none}\n\n/* Popovers float over the rows below instead of pushing them down. */\n.as-pop{position:absolute;z-index:999;left:64px;right:14px;padding:6px;border-radius:12px;background:var(--pop);box-shadow:0 0 0 1px var(--line),0 12px 32px rgba(0,0,0,.45)}\nhtml[data-k-theme=light] .as-pop{box-shadow:0 0 0 1px var(--line),0 12px 28px rgba(0,0,0,.16)}\n.as-pop[hidden]{display:none}\n.as-list{max-height:180px;overflow-y:auto}\n.as-opt{display:flex;align-items:center;width:100%;height:28px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:var(--ink-1);font:inherit;font-size:13px;text-align:left;cursor:pointer}\n.as-opt>span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.as-opt:hover{background:var(--fill-2)}\n.as-opt.as-none{color:var(--ink-3)}\n.as-opt[aria-selected=true]::after{content:\"\";flex:none;width:9px;height:5px;margin:-3px 2px 0 8px;border:solid var(--accent);border-width:0 0 2px 2px;transform:rotate(-45deg)}\n\n.as-quick{display:flex;gap:4px;padding:0 0 6px;margin-bottom:6px;border-bottom:1px solid var(--line)}\n.as-c{flex:1;height:26px;padding:0 6px;border:0;border-radius:7px;background:var(--fill-1);color:var(--ink-1);font:inherit;font-size:12px;font-weight:500;cursor:pointer;white-space:nowrap}\n.as-c:hover{background:var(--fill-2)}\n.as-c[aria-pressed=true]{background:var(--accent);color:#fff}\n/* Clear sits at the top: the bottom-right corner belongs to the host's Create task button. */\n.as-clear{flex:none;height:26px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:var(--ink-2);font:inherit;font-size:12px;font-weight:500;cursor:pointer}\n.as-clear:hover{background:var(--fill-2);color:var(--ink-1)}\n.as-clear:disabled{color:var(--ink-4);background:transparent;cursor:default}\n\n.as-calh{display:flex;align-items:center;justify-content:space-between;padding:2px 2px 4px;font-size:12.5px;font-weight:600}\n.as-calh button{width:24px;height:24px;border:0;border-radius:6px;background:transparent;color:var(--ink-2);font-size:15px;line-height:1;cursor:pointer}\n.as-calh button:hover{background:var(--fill-2)}\n.as-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center}\n.as-grid>span{font-size:10px;color:var(--ink-4);padding:2px 0 3px}\n.as-grid>button{height:26px;border:0;border-radius:6px;background:transparent;color:var(--ink-1);font:inherit;font-size:12px;font-variant-numeric:tabular-nums;cursor:pointer}\n.as-grid>button:hover{background:var(--fill-2)}\n.as-grid>button.as-past{color:var(--ink-4)}\n.as-grid>button.as-today{color:var(--accent);font-weight:600}\n.as-grid>button[aria-pressed=true]{background:var(--accent);color:#fff}\n\n.as button:focus-visible,.as-title:focus-visible{outline:2px solid var(--accent);outline-offset:1px}\n.as-title:focus-visible{outline:none;border-bottom-width:3px}\n@media(prefers-reduced-motion:reduce){.as-val svg{transition:none}}\n</style></head><body><div class=\"k-cwrap k-confirm\"><div class=\"as\">\n<div class=\"as-head\"><span class=\"k-mk\" data-k-mk><img class=\"k-mk-i\" src=\"data:image/png;base64,\" alt=\"\"></span><span class=\"as-chip\">New task</span></div>\n<input class=\"as-title\" data-voiceos-key=\"name\" placeholder=\"Task name\" spellcheck=\"false\" autocomplete=\"off\" />\n<input type=\"hidden\" id=\"as-due_on\" data-voiceos-key=\"due_on\" />\n<input type=\"hidden\" id=\"as-due_time\" data-voiceos-key=\"due_time\" />\n<div class=\"as-row\"><span class=\"as-lbl\">Due</span><button type=\"button\" class=\"as-val\" data-menu=\"cal\" id=\"as-due-btn\" aria-expanded=\"false\" aria-haspopup=\"dialog\"><svg class=\"as-ic\" width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><rect x=\"1.75\" y=\"2.75\" width=\"10.5\" height=\"9.5\" rx=\"2\"/><path d=\"M1.75 5.75h10.5M4.75 1.25v2.5M9.25 1.25v2.5\"/></svg><span></span><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2.5 3.75L5 6.25l2.5-2.5\"/></svg></button><button type=\"button\" class=\"as-val as-time\" data-menu=\"due_time\" aria-expanded=\"false\" aria-label=\"Due time\" hidden><span></span><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2.5 3.75L5 6.25l2.5-2.5\"/></svg></button></div>\n<div class=\"as-pop\" id=\"as-pop-cal\" role=\"dialog\" aria-label=\"Due date\" hidden>\n<div class=\"as-quick\"><button type=\"button\" class=\"as-c\" data-q=\"today\">Today</button><button type=\"button\" class=\"as-c\" data-q=\"tomorrow\">Tomorrow</button><button type=\"button\" class=\"as-c\" data-q=\"mon\">Next Mon</button><button type=\"button\" class=\"as-clear\" id=\"as-clear\">Clear</button></div>\n<div class=\"as-calh\"><button type=\"button\" id=\"as-prev\" aria-label=\"Previous month\">&lsaquo;</button><span id=\"as-month\"></span><button type=\"button\" id=\"as-next\" aria-label=\"Next month\">&rsaquo;</button></div><div class=\"as-grid\" id=\"as-grid\"></div>\n</div>\n<div class=\"as-pop\" id=\"as-pop-due_time\" hidden><div class=\"as-list\" role=\"listbox\" aria-label=\"Due time\"></div></div>\n\n<input type=\"hidden\" id=\"as-project\" data-voiceos-key=\"project\" />\n<div class=\"as-row\"><span class=\"as-lbl\">Project</span><button type=\"button\" class=\"as-val\" data-menu=\"project\" aria-expanded=\"false\"><span></span><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2.5 3.75L5 6.25l2.5-2.5\"/></svg></button></div>\n<div class=\"as-pop\" id=\"as-pop-project\" hidden><div class=\"as-list\" role=\"listbox\" aria-label=\"Project\"></div></div>\n\n<input type=\"hidden\" id=\"as-section\" data-voiceos-key=\"section\" />\n<div class=\"as-row\"><span class=\"as-lbl\">Section</span><button type=\"button\" class=\"as-val\" data-menu=\"section\" aria-expanded=\"false\"><span></span><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2.5 3.75L5 6.25l2.5-2.5\"/></svg></button></div>\n<div class=\"as-pop\" id=\"as-pop-section\" hidden><div class=\"as-list\" role=\"listbox\" aria-label=\"Section\"></div></div>\n</div>\n<script>(function(){\n/* Runs before the kit's init handler (this script precedes it); the kit then\n   hydrates the keyed hidden inputs from args, so we render from args directly. */\nvar $=function(id){return document.getElementById(id)};\n/* Programmatic value changes don't fire 'input'; the kit stages edits from that event. */\nfunction stage(el,v){el.value=v;el.dispatchEvent(new Event('input',{bubbles:true}))}\nvar pad=function(n){return(n<10?'0':'')+n};\nvar ymd=function(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())};\nvar parse=function(s){var m=/^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s||'');return m?new Date(+m[1],m[2]-1,+m[3]):null};\nvar today=new Date();today.setHours(0,0,0,0);\nvar plus=function(n){var d=new Date(today);d.setDate(d.getDate()+n);return d};\nvar quick={today:ymd(today),tomorrow:ymd(plus(1)),mon:ymd(plus((8-today.getDay())%7||7))};\nvar MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nvar DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\nvar view=new Date(today.getFullYear(),today.getMonth(),1);\nvar clock=function(v){var m=/^(\\d{1,2}):(\\d{2})/.exec(v);if(!m)return v;var h=+m[1];return((h+11)%12+1)+':'+m[2]+(h<12?' AM':' PM')};\n\n/* Each menu: options [{v,l}], the first being the \"none\" choice. */\nvar menus={due_time:[{v:'',l:'No time'}],project:[{v:'',l:'No project'}],section:[{v:'',l:'Default section'}]};\nfor(var h=0;h<24;h++)for(var m=0;m<60;m+=30){var t=pad(h)+':'+pad(m);menus.due_time.push({v:t,l:clock(t)})}\n/* The value that will execute always gets an option, so the card never shows less than it sends. */\nfunction ensure(key,v,label){if(!v)return;for(var i=0;i<menus[key].length;i++)if(menus[key][i].v===v)return;menus[key].push({v:v,l:label||v})}\nfunction labelOf(key,v){for(var i=0;i<menus[key].length;i++)if(menus[key][i].v===v)return menus[key][i].l;return v}\n\nvar openId='';\nfunction closeAll(except){\n  openId=except||'';\n  var pops=document.querySelectorAll('.as-pop');\n  for(var i=0;i<pops.length;i++)pops[i].hidden=pops[i].id!==openId;\n  var vals=document.querySelectorAll('.as-val');\n  for(var j=0;j<vals.length;j++)vals[j].setAttribute('aria-expanded',String('as-pop-'+vals[j].getAttribute('data-menu')===openId));\n  place();\n}\n/* Anchor the open popover under its row. The frame is only as tall as the\n   document, so when the popover would run past the card bottom the document\n   grows (min-height) instead of the rows moving; 52px keeps the list clear of\n   the host's floating confirm button. */\nfunction place(){\n  var root=document.documentElement;root.style.minHeight='';\n  if(!openId)return;\n  var pop=$(openId),btn=document.querySelector('[data-menu=\"'+openId.slice(7)+'\"]');\n  var top=btn.getBoundingClientRect().bottom-document.querySelector('.as').getBoundingClientRect().top+4;\n  pop.style.top=top+'px';\n  var need=Math.ceil(pop.getBoundingClientRect().bottom+52);\n  if(need>root.getBoundingClientRect().height)root.style.minHeight=need+'px';\n}\nfunction renderMenu(key){\n  var btn=document.querySelector('[data-menu=\"'+key+'\"]'),v=$('as-'+key).value;\n  var noDate=key==='due_time'&&!$('as-due_on').value;\n  btn.hidden=noDate;\n  btn.querySelector('span').textContent=key==='due_time'&&!v?'Add time':labelOf(key,v);\n  btn.classList.toggle('as-empty',!v);\n  var list=$('as-pop-'+key).firstChild;list.textContent='';\n  menus[key].forEach(function(o,i){\n    var b=document.createElement('button');\n    b.type='button';b.className='as-opt'+(i===0?' as-none':'');b.setAttribute('role','option');\n    b.setAttribute('data-key',key);b.setAttribute('data-v',o.v);b.setAttribute('aria-selected',String(o.v===v));\n    var s=document.createElement('span');s.textContent=o.l;b.appendChild(s);list.appendChild(b);\n  });\n}\nfunction renderDate(){\n  var v=$('as-due_on').value,d=parse(v);\n  var chips=document.querySelectorAll('.as-c[data-q]');\n  for(var i=0;i<chips.length;i++)chips[i].setAttribute('aria-pressed',String(quick[chips[i].getAttribute('data-q')]===v));\n  var btn=$('as-due-btn');\n  btn.querySelector('span').textContent=!d?'No due date':v===quick.today?'Today':v===quick.tomorrow?'Tomorrow':DAYS[d.getDay()]+', '+MONTHS[d.getMonth()]+' '+d.getDate()+(d.getFullYear()!==today.getFullYear()?', '+d.getFullYear():'');\n  btn.classList.toggle('as-empty',!d);\n  $('as-clear').disabled=!v;\n  $('as-month').textContent=MONTHS[view.getMonth()]+' '+view.getFullYear();\n  var g=$('as-grid');g.textContent='';\n  'Su Mo Tu We Th Fr Sa'.split(' ').forEach(function(t){var s=document.createElement('span');s.textContent=t;g.appendChild(s)});\n  for(var k=0;k<view.getDay();k++)g.appendChild(document.createElement('span'));\n  var n=new Date(view.getFullYear(),view.getMonth()+1,0).getDate();\n  for(var day=1;day<=n;day++){\n    var dd=new Date(view.getFullYear(),view.getMonth(),day),b=document.createElement('button');\n    b.type='button';b.textContent=day;b.setAttribute('data-v',ymd(dd));\n    b.className=+dd===+today?'as-today':dd<today?'as-past':'';\n    b.setAttribute('aria-pressed',String(ymd(dd)===v));g.appendChild(b);\n  }\n  renderMenu('due_time');\n}\n/* Clearing the date also clears its time. */\nfunction setDate(v){stage($('as-due_on'),v);if(!v&&$('as-due_time').value)stage($('as-due_time'),'');renderDate()}\n\ndocument.addEventListener('click',function(e){\n  var t=e.target;if(!t||!t.closest)return;\n  var chip=t.closest('.as-c[data-q]');\n  if(chip){setDate(quick[chip.getAttribute('data-q')]);closeAll('');return}\n  if(t.closest('#as-clear')){setDate('');closeAll('');return}\n  if(t.closest('#as-prev')){view.setMonth(view.getMonth()-1);renderDate();place();return}\n  if(t.closest('#as-next')){view.setMonth(view.getMonth()+1);renderDate();place();return}\n  var day=t.closest('#as-grid>button');\n  if(day){setDate(day.getAttribute('data-v'));closeAll('');return}\n  var val=t.closest('.as-val');\n  if(val){\n    var key=val.getAttribute('data-menu'),open=val.getAttribute('aria-expanded')!=='true';\n    if(open&&key==='cal'){var d=parse($('as-due_on').value)||today;view=new Date(d.getFullYear(),d.getMonth(),1);renderDate()}\n    closeAll(open?'as-pop-'+key:'');\n    if(open&&key!=='cal'){var pop=$('as-pop-'+key),sel=pop.querySelector('[aria-selected=true]:not(.as-none)')||pop.querySelector('[data-v=\"09:00\"]');if(sel)pop.firstChild.scrollTop=sel.offsetTop-pop.firstChild.offsetTop-(pop.firstChild.clientHeight-sel.offsetHeight)/2}\n    return;\n  }\n  var opt=t.closest('.as-opt');\n  if(opt){var k=opt.getAttribute('data-key');stage($('as-'+k),opt.getAttribute('data-v'));closeAll('');renderMenu(k);return}\n  /* A click anywhere outside the open popover dismisses it. */\n  if(!t.closest('.as-pop'))closeAll('');\n});\ndocument.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll('')});\n\naddEventListener('message',function(e){\n  if(e.source!==parent||!e.data||e.data.type!=='voiceos:init')return;\n  var a=e.data.args||{};\n  [['project',a.project_choices],['section',a.section_choices]].forEach(function(p){\n    (Array.isArray(p[1])?p[1]:[]).forEach(function(c){if(c&&c.gid!=null)ensure(p[0],String(c.gid),String(c.name||c.gid))});\n  });\n  ensure('project',a.project?String(a.project):'');\n  ensure('section',a.section?String(a.section):'');\n  ensure('due_time',a.due_time?String(a.due_time):'',a.due_time?clock(String(a.due_time)):'');\n  ['due_on','due_time','project','section'].forEach(function(k){$('as-'+k).value=a[k]==null?'':String(a[k])});\n  var d=parse(a.due_on);if(d)view=new Date(d.getFullYear(),d.getMonth(),1);\n  renderDate();renderMenu('project');renderMenu('section');\n});\nrenderDate();renderMenu('project');renderMenu('section');\n})();</script></div><div class=\"k-rim\" aria-hidden=\"true\"></div><script>(function(){\nvar send=function(m){try{parent.postMessage(m,'*')}catch(e){}};\n/* Result-widget actions. Only the parent can advertise access or return a result.\n   Confirmation is owned by VoiceOS, outside this document. Never retry a send. */\nvar pendingTools=new Map();\nvar voiceos=window.voiceos=window.voiceos||{};\nvoiceos.canInvokeTools=false;\nvoiceos.invokeTool=function(name,args,options){\n  var id=options&&options.requestId;\n  if(!id){var bytes=new Uint32Array(4);crypto.getRandomValues(bytes);id=Array.from(bytes,function(n){return n.toString(16)}).join('_')}\n  var failure=function(status,error){return {type:'voiceos:toolResult',requestId:id,status:status,error:error}};\n  if(typeof id!=='string'||!/^[a-zA-Z0-9_-]{1,128}$/.test(id))return Promise.resolve(failure('failed','Invalid requestId.'));\n  if(!voiceos.canInvokeTools)return Promise.resolve(failure('failed','Tool actions are unavailable in this card.'));\n  var signature;try{signature=JSON.stringify([name,args])}catch(e){return Promise.resolve(failure('failed','Arguments must be JSON.'))}\n  var prior=pendingTools.get(id);\n  if(prior)return prior.signature===signature?prior.promise:Promise.resolve(failure('failed','This requestId already has different arguments.'));\n  if(pendingTools.size>=64)return Promise.resolve(failure('failed','Too many pending actions.'));\n  var resolve;var promise=new Promise(function(done){resolve=done});\n  var timer=setTimeout(function(){pendingTools.delete(id);resolve(failure('unknown','No final response. Check the app before trying again.'))},135000);\n  pendingTools.set(id,{resolve:resolve,promise:promise,timer:timer,signature:signature});\n  send({type:'voiceos:invokeTool',name:name,args:args,requestId:id});\n  return promise;\n};\nvar last=0;\nvar report=function(){\n  /* Never report a collapsed measurement. A frame that is display:none, zero\n     width, or in a hidden tab measures ~0, and since the host CLAMPS to 60 and\n     we'd then consider that our last known height, one bad sample pins a\n     277px card at 60px forever. Staying silent leaves the declared estimate\n     in place, which is close to right by construction. */\n  if(document.hidden)return;\n  var el=document.documentElement;\n  if(!el.offsetWidth)return;\n  var h=Math.ceil(el.getBoundingClientRect().height);\n  if(h<8)return;\n  if(Math.abs(h-last)>1){last=h;send({type:'voiceos:resize',height:h})}\n};\n/* data-voiceos-key is the alias custom markup uses; data-k-key is what the\n   kit's own vField emits. Same contract either way. */\nvar argKey=function(el){\n  if(!el||!el.getAttribute)return null;\n  return el.getAttribute('data-k-key')||el.getAttribute('data-voiceos-key');\n};\naddEventListener('message',function(e){\n  if(e.source!==parent)return;\n  var m=e.data;if(!m)return;\n  if(m.type==='voiceos:toolResult'){\n    var pending=pendingTools.get(m.requestId);\n    if(pending&&['completed','failed','cancelled','unknown'].indexOf(m.status)!==-1){clearTimeout(pending.timer);pendingTools.delete(m.requestId);pending.resolve(m)}\n    return;\n  }\n  if(m.type!=='voiceos:init')return;\n  voiceos.canInvokeTools=!!(m.capabilities&&m.capabilities.invokeTool);\n  if(m.theme&&m.theme.mode)document.documentElement.setAttribute('data-k-theme',m.theme.mode);\n  /* The corner the HOST will actually cut this card at. Same shape as the\n     theme leg: the document ships with a correct default and the surface\n     corrects it, so a card is never briefly drawn at the wrong radius and\n     never depends on the host to send anything. Clamped because the value\n     lands in CSS. */\n  if(typeof m.radius==='number'&&isFinite(m.radius))document.documentElement.style.setProperty('--k-radius',Math.max(0,Math.min(48,m.radius))+'px');\n  var args=m.args||{};\n  var fields=document.querySelectorAll('[data-k-key],[data-voiceos-key]');\n  for(var i=0;i<fields.length;i++){\n    var key=argKey(fields[i]);\n    if(Object.prototype.hasOwnProperty.call(args,key)&&args[key]!=null)fields[i].value=String(args[key]);\n  }\n  report();\n});\ndocument.addEventListener('input',function(e){\n  var key=argKey(e.target);\n  if(key)send({type:'voiceos:updateInput',key:key,value:e.target.value});\n});\ndocument.addEventListener('click',function(e){\n  /* Routes BOTH the kit's data-k-link rows and plain <a href=\"https://…\">\n     anchors in custom markup out through the host. The sandbox blocks\n     navigation anyway, so an unrouted anchor is a click that does nothing. */\n  var el=e.target;\n  while(el&&el!==document.body){\n    if(el.getAttribute&&(el.hasAttribute('data-k-link')||(el.tagName==='A'&&el.hasAttribute('href')))){\n      e.preventDefault();\n      var href=el.getAttribute('href')||'';\n      if(/^https:\\/\\//i.test(href))send({type:'voiceos:openUrl',url:href});\n      return;\n    }\n    el=el.parentNode;\n  }\n});\nif(window.ResizeObserver){new ResizeObserver(report).observe(document.documentElement)}\naddEventListener('load',report);setTimeout(report,0);setTimeout(report,120);\n})()</script></body></html>",
          "height": 236,
          "confirmLabel": "Create task"
        }
      }
    }
  ],
